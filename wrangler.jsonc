{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pcmadang",
  "compatibility_date": "2026-10-10",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist-production",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "none"
  }
}
